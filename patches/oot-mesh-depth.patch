+++ b/dm/tools/tests/test_vka_mesh_depth.py
@@ -0,0 +1,50 @@
+"""Exercise the production fallback's depth state with the host C compiler.
+
+The colour pass must supply the depth omitted by mesh_cut, without changing
+unpaired draws or other depth modes that happen to use a paired shader.
+"""
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+class MeshDepth(unittest.TestCase):
+    def test_depth_replacement_and_other_passes(self):
+        cc = shutil.which('cc')
+        if not cc:
+            self.skipTest('no C compiler')
+        source = (ROOT / 'dm/gfx/vk_android/vka_draw.c').read_text()
+        function = re.search(r'static void mesh_cut_depth\([^\n]+\) \{.*?\n\}', source, re.S)
+        self.assertIsNotNone(function)
+        harness = '''
+#include <stdint.h>
+#include <assert.h>
+enum { NVN_DEPTH_FUNC_EQUAL = 3, NVN_DEPTH_FUNC_LEQUAL = 4 };
+'''+function.group()+'''
+int main(void) {
+    for (int pair = 0; pair < 2; ++pair)
+    for (int test = 0; test < 2; ++test)
+    for (uint32_t write = 0; write < 2; ++write)
+    for (uint32_t func = 1; func <= 8; ++func) {
+        uint32_t w = write, f = func;
+        mesh_cut_depth(pair, test, &w, &f);
+        if (pair && test && !write && func == NVN_DEPTH_FUNC_EQUAL) {
+            assert(w == 1 && f == NVN_DEPTH_FUNC_LEQUAL);
+        } else { assert(w == write && f == func); }
+    }
+}
+'''
+        with tempfile.TemporaryDirectory() as d:
+            p = Path(d)
+            (p / 'test.c').write_text(harness)
+            subprocess.run([cc, '-std=c11', '-Wall', '-Wextra', '-Werror', str(p / 'test.c'), '-o', str(p / 'test')], check=True)
+            subprocess.run([str(p / 'test')], check=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
