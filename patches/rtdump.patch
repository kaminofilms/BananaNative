+                    uint32_t cc[7] = {GW(G_OpConstantComposite, 3 + n), tf[n], cst[n][k], k == 1 ? lo : hi, k == 1 ? lo : hi, k == 1 ? lo : hi, k == 1 ? lo : hi};
+                    if (!gput_n(&o, cc, 3 + n)) GFAIL("out of memory");
+                }
+            }
+        }
+        if (op == G_OpStore && len >= 3 && a[0] < bound && derived[a[0]]) {
+            uint32_t pt = derived[a[0]] - 1, t = pt < bound ? ptee[pt] : 0, n = t && t < bound ? flt[t] : 0;
