+// DM_VK_RTDUMP: a frame's render targets as small PNG previews, for finding the pass that makes a picture wrong without a desktop GPU debugger (Android, restart).
+//   DM_VK_RTDUMP=<frame>         dump that frame (vka_frame numbering, as in the log's [longframe] lines)
+//   DM_VK_RTDUMP=@<seconds>      dump the first frame that starts that many seconds after the replay's first frame (frame rates vary on the phone)
+//   DM_VK_RTDUMP_FRAMES=<n>      dump n frames in a row (default 1)
+//   DM_VK_RTDUMP_PX=<n>          the previews' longer side (default 512; colour targets are scaled on the GPU with a linear blit, depth on the CPU)
+//   DM_VK_RTDUMP_MAX=<n>         the most images written in the run (default 400)
+//   DM_VK_RTDUMP_DIR=<dir>       the folder written into instead of $DM_TEMP/rtdump (a shared folder such as /storage/emulated/0/Download/rtdump, which the app can write with all-files access)
+// After every render pass of the frame, each colour attachment (the level and layer the pass drew) and its depth attachment; after every compute dispatch, the float
+// storage images it bound (level 0, layer 0). Each is read back after its submission completes and written to $DM_TEMP/rtdump/f<frame>/ as
+//   <seq>_<p|d><pass>_s<serial>_<vkformat>_<w>x<h>_<first fragment or compute key>.png
+// Colour: the raw values' statistics are logged (`rtdump` lines: per channel min, max and mean, and NaN / infinite counts), then the picture is exposed so its mean luminance is
+// 0.18, Reinhard-mapped and gamma-encoded (the game's own scale, 2^-EV, would otherwise leave it black). Depth: min..max of the level stretched to black..white, with the range logged.
+// Integer and block-compressed targets are skipped (logged once). Costs GPU and CPU time in the frames it dumps only; diagnostic, not for play.
+#if defined(__ANDROID__)
+#include "vka.h"
+#include <errno.h>
+#include <math.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <zlib.h>
+
+#define VLOG(...) LOG("[vk] " __VA_ARGS__)
+uint64_t vka_frame(void);
+
+static int g_init, g_on, g_px = 512, g_max = 400, g_nframes = 1;
+static long long g_frame0 = -1; static double g_at = -1; static uint64_t g_t0;
+static _Atomic int g_written, g_seq;
+static uint32_t g_pass;                                // render passes and dispatches of the dumped frames, in order
+static uint64_t g_fs[3]; static uint32_t g_nfs, g_ndraws;   // the pass's first fragment shader keys and its draws
+static uint64_t g_cur_frame = ~0ull;
+
+static uint64_t mono_ns(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec; }
+int vka_rtd_on(void) {
+    if (!g_init) {
+        g_init = 1;
+        const char *e = getenv("DM_VK_RTDUMP");
+        if (e && *e) {
+            if (*e == '@') g_at = strtod(e + 1, NULL); else g_frame0 = strtoll(e, NULL, 10);
+            const char *p = getenv("DM_VK_RTDUMP_PX"), *m = getenv("DM_VK_RTDUMP_MAX"), *n = getenv("DM_VK_RTDUMP_FRAMES");
+            if (p && atoi(p) >= 32) g_px = atoi(p);
+            if (m && atoi(m) > 0) g_max = atoi(m);
+            if (n && atoi(n) > 0) g_nframes = atoi(n);
+            g_on = g_at >= 0 || g_frame0 >= 0;
+            if (g_on) VLOG("DM_VK_RTDUMP: %s %s, %d frame(s), previews %d px, at most %d images, into $DM_TEMP/rtdump", g_at >= 0 ? "at" : "frame", e[0] == '@' ? e + 1 : e, g_nframes, g_px, g_max);
+        }
+    }
+    return g_on;
+}
+// Is the frame being recorded one to dump (the time trigger picks its frame once)
+static int want(void) {
+    if (!vka_rtd_on() || atomic_load(&g_written) >= g_max) return 0;
+    uint64_t f = vka_frame();
+    if (g_frame0 < 0) {
+        if (!g_t0) g_t0 = mono_ns();
+        if ((double)(mono_ns() - g_t0) / 1e9 < g_at) return 0;
+        g_frame0 = (long long)f; VLOG("DM_VK_RTDUMP: %.1f s reached at frame %llu", g_at, (unsigned long long)f);
+    }
+    if (f < (uint64_t)g_frame0 || f >= (uint64_t)g_frame0 + (uint64_t)g_nframes) return 0;
+    if (f != g_cur_frame) { g_cur_frame = f; g_pass = 0; VLOG("DM_VK_RTDUMP: dumping frame %llu", (unsigned long long)f); }
+    return 1;
+}
+int vka_rtd_active(void) { return want(); }
+void vka_rtd_draw(uint64_t fs) {   // a draw of the open pass (its fragment shader key, 0 = none)
+    if (!g_on) return;
+    g_ndraws++;
+    for (uint32_t i = 0; i < g_nfs; i++) if (g_fs[i] == fs) return;
+    if (g_nfs < 3) g_fs[g_nfs++] = fs;
+}
+
+// ---------- One readback ----------
+typedef struct job {
+    struct job *next;
+    VkBuffer buf; VkDeviceMemory bm; void *p;          // host-visible readback
+    VkImage tmp; VkDeviceMemory tm;                    // the scaled RGBA16F copy of a colour target (none for depth)
+    uint32_t w, h, sw, sh, depth_bytes; VkFormat vf; int depth;
+    uint64_t frame, serial, key; uint32_t pass, seq, ndraws; char kind; uint32_t nvfmt;
+} job;
+static job *g_jobs;   // this submission's, written once its fence is done
+
+static int hbuf(VkDeviceSize n, VkBuffer *b, VkDeviceMemory *m, void **p) {
+    VkBufferCreateInfo bi = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .size = n, .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT};
+    if (vk.vkCreateBuffer(V.dev, &bi, NULL, b)) return 0;
+    VkMemoryRequirements mr; vk.vkGetBufferMemoryRequirements(V.dev, *b, &mr);
+    uint32_t t = vka_mem_type(mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT, 0);
+    if (t == UINT32_MAX) t = vka_mem_type(mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, 0);
+    VkMemoryAllocateInfo ai = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .allocationSize = mr.size, .memoryTypeIndex = t};
+    if (t == UINT32_MAX || vk.vkAllocateMemory(V.dev, &ai, NULL, m)) { vk.vkDestroyBuffer(V.dev, *b, NULL); *b = VK_NULL_HANDLE; return 0; }
+    if (vk.vkBindBufferMemory(V.dev, *b, *m, 0) || vk.vkMapMemory(V.dev, *m, 0, VK_WHOLE_SIZE, 0, p)) {
+        vk.vkDestroyBuffer(V.dev, *b, NULL); vk.vkFreeMemory(V.dev, *m, NULL); *b = VK_NULL_HANDLE; *m = VK_NULL_HANDLE; return 0; }
+    return 1;
+}
+static void job_free(job *j) {
+    if (j->buf) vk.vkDestroyBuffer(V.dev, j->buf, NULL);
+    if (j->bm) vk.vkFreeMemory(V.dev, j->bm, NULL);
+    if (j->tmp) vk.vkDestroyImage(V.dev, j->tmp, NULL);
+    if (j->tm) vk.vkFreeMemory(V.dev, j->tm, NULL);
+    free(j);
+}
+static int can_blit(VkFormat f) {   // linear blits from this format (cached for 16 formats)
+    static VkFormat seen[16]; static int ok[16], n;
+    for (int i = 0; i < n; i++) if (seen[i] == f) return ok[i];
+    VkFormatProperties fp; vk.vkGetPhysicalDeviceFormatProperties(V.pd, f, &fp);
+    int r = (fp.optimalTilingFeatures & VK_FORMAT_FEATURE_BLIT_SRC_BIT) && (fp.optimalTilingFeatures & VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT);
+    if (n < 16) { seen[n] = f; ok[n++] = r; }
+    return r;
+}
+static void host_barrier(VkCommandBuffer cb) {
+    VkMemoryBarrier mb = {VK_STRUCTURE_TYPE_MEMORY_BARRIER, .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_HOST_READ_BIT};
+    vk.vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+}
+// Level lv, layer l0 of im (kept in VK_IMAGE_LAYOUT_GENERAL, as the replay keeps its images) into a new job
+static void dump_one(VkCommandBuffer cb, vka_img *im, uint32_t lv, uint32_t l0, char kind, uint64_t key) {
+    if (!im || !im->img || im->samples > 1 || im->depth > 1 || lv >= im->levels || l0 >= im->layers) return;
+    if (atomic_load(&g_seq) >= g_max) return;
+    if (!(im->usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT)) { static int n; if (n++ < 4) VLOG("rtdump: serial %llu has no transfer source use: skipped", (unsigned long long)im->serial); return; }
+    uint32_t w = im->w >> lv ? im->w >> lv : 1, h = im->h >> lv ? im->h >> lv : 1;
+    job *j = calloc(1, sizeof *j); if (!j) return;
+    j->w = w; j->h = h; j->frame = vka_frame(); j->serial = im->serial; j->key = key; j->pass = g_pass; j->kind = kind; j->nvfmt = (uint32_t)im->d.format; j->vf = im->f.vk; j->ndraws = g_ndraws;
+    if (im->f.kind == 3 || im->f.kind == 5) {   // depth: the whole level as it is (D16: 2 bytes, the others' depth aspect: 4)
+        j->depth = 1; j->depth_bytes = im->f.vk == VK_FORMAT_D16_UNORM ? 2 : 4;
+        VkDeviceSize n = (VkDeviceSize)w * h * j->depth_bytes;
+        if (n > 64ull << 20 || !hbuf(n, &j->buf, &j->bm, &j->p)) { free(j); return; }
+        VkBufferImageCopy c = {0, 0, 0, {VK_IMAGE_ASPECT_DEPTH_BIT, lv, l0, 1}, {0, 0, 0}, {w, h, 1}};
+        vk.vkCmdCopyImageToBuffer(cb, im->img, VK_IMAGE_LAYOUT_GENERAL, j->buf, 1, &c);
+    } else if (im->f.kind == 0 && im->f.bw <= 1 && im->f.bh <= 1 && can_blit(im->f.vk)) {   // colour: scaled into RGBA16F on the GPU
+        float s = (float)g_px / (float)(w > h ? w : h); if (s > 1) s = 1;
+        j->sw = (uint32_t)(w * s); j->sh = (uint32_t)(h * s); if (!j->sw) j->sw = 1; if (!j->sh) j->sh = 1;
+        VkImageCreateInfo ci = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = VK_IMAGE_TYPE_2D, .format = VK_FORMAT_R16G16B16A16_SFLOAT, .extent = {j->sw, j->sh, 1}, .mipLevels = 1,
+            .arrayLayers = 1, .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL, .usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+            .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED};
+        if (vk.vkCreateImage(V.dev, &ci, NULL, &j->tmp)) { j->tmp = VK_NULL_HANDLE; job_free(j); return; }
+        VkMemoryRequirements mr; vk.vkGetImageMemoryRequirements(V.dev, j->tmp, &mr);
+        uint32_t t = vka_mem_type(mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, 0); if (t == UINT32_MAX) t = vka_mem_type(mr.memoryTypeBits, 0, 0);
+        VkMemoryAllocateInfo ai = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .allocationSize = mr.size, .memoryTypeIndex = t};
+        if (t == UINT32_MAX || vk.vkAllocateMemory(V.dev, &ai, NULL, &j->tm) || vk.vkBindImageMemory(V.dev, j->tmp, j->tm, 0)) { job_free(j); return; }
+        if (!hbuf((VkDeviceSize)j->sw * j->sh * 8, &j->buf, &j->bm, &j->p)) { job_free(j); return; }
+        vka_img_barrier(cb, j->tmp, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+        VkImageBlit bl = {{VK_IMAGE_ASPECT_COLOR_BIT, lv, l0, 1}, {{0, 0, 0}, {(int32_t)w, (int32_t)h, 1}}, {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, {{0, 0, 0}, {(int32_t)j->sw, (int32_t)j->sh, 1}}};
+        vk.vkCmdBlitImage(cb, im->img, VK_IMAGE_LAYOUT_GENERAL, j->tmp, VK_IMAGE_LAYOUT_GENERAL, 1, &bl, VK_FILTER_LINEAR);
+        vka_barrier(cb);
+        VkBufferImageCopy c = {0, 0, 0, {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, {0, 0, 0}, {j->sw, j->sh, 1}};
