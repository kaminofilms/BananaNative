+        }
+        if (i == first_fn) {   // the new types and constants, before the first function
+            if (nbool[1]) { uint32_t t[2] = {GW(G_OpTypeBool, 2), nbool[1]}; if (!gput_n(&o, t, 2)) GFAIL("out of memory"); }
+            for (int n = 2; n <= 4; n++) if (nbool[n]) { uint32_t t[4] = {GW(G_OpTypeVector, 4), nbool[n], t_bvec[1], (uint32_t)n}; if (!gput_n(&o, t, 4)) GFAIL("out of memory"); }
+            uint32_t c[8] = {GW(G_OpConstant, 4), t_f32, lo, 0xf149f2cau, GW(G_OpConstant, 4), t_f32, hi, 0x7149f2cau};   // -1e30, 1e30
+            if (!gput_n(&o, c, 8)) GFAIL("out of memory");
+            for (int n = 1; n <= 4; n++) if (tf[n]) {
+                uint32_t z[3] = {GW(G_OpConstantNull, 3), tf[n], cst[n][0]}; if (!gput_n(&o, z, 3)) GFAIL("out of memory");
