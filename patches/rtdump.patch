+    }
+    j->seq = (uint32_t)atomic_fetch_add(&g_seq, 1);
+    j->next = g_jobs; g_jobs = j;
+}
+
+// ---------- After the GPU: statistics and PNG ----------
+static float half_f(uint16_t h) {
+    uint32_t s = (uint32_t)(h >> 15) << 31, e = (h >> 10) & 31, m = h & 1023, u;
+    if (!e) { if (!m) u = s; else { e = 113; while (!(m & 1024)) { m <<= 1; e--; } m &= 1023; u = s | (e << 23) | (m << 13); } }
+    else if (e == 31) u = s | 0x7f800000u | (m << 13);
+    else u = s | ((e + 112) << 23) | (m << 13);
+    float f; memcpy(&f, &u, 4); return f;
+}
+static void put32(uint8_t *p, uint32_t v) { p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v; }
+static int png_chunk(FILE *f, const char *type, const uint8_t *d, uint32_t n) {
+    uint8_t h[8]; put32(h, n); memcpy(h + 4, type, 4);
+    uLong c = crc32(0, (const Bytef *)type, 4); if (n) c = crc32(c, d, n);
+    uint8_t t[4]; put32(t, (uint32_t)c);
+    return fwrite(h, 1, 8, f) == 8 && (!n || fwrite(d, 1, n, f) == n) && fwrite(t, 1, 4, f) == 4;
+}
+static int png_write(const char *path, const uint8_t *rgb, uint32_t w, uint32_t h) {
+    size_t raw = (size_t)(w * 3 + 1) * h; uint8_t *r = malloc(raw); if (!r) return 0;
+    for (uint32_t y = 0; y < h; y++) { r[y * (w * 3 + 1)] = 0; memcpy(r + y * (w * 3 + 1) + 1, rgb + (size_t)y * w * 3, (size_t)w * 3); }
+    uLongf zn = compressBound((uLong)raw); uint8_t *z = malloc(zn);
+    if (!z || compress2(z, &zn, r, (uLong)raw, 6) != Z_OK) { free(r); free(z); return 0; }
+    FILE *f = fopen(path, "wb"); int ok = 0;
+    if (f) {
+        uint8_t ih[13]; put32(ih, w); put32(ih + 4, h); ih[8] = 8; ih[9] = 2; ih[10] = ih[11] = ih[12] = 0;
+        ok = fwrite("\x89PNG\r\n\x1a\n", 1, 8, f) == 8 && png_chunk(f, "IHDR", ih, 13) && png_chunk(f, "IDAT", z, (uint32_t)zn) && png_chunk(f, "IEND", NULL, 0);
+        ok = fclose(f) == 0 && ok;
+    }
+    free(r); free(z); return ok;
+}
+static void mkdirs(const char *p) {
+    char b[512]; snprintf(b, sizeof b, "%s", p);
+    for (char *s = b + 1; *s; s++) if (*s == '/') { *s = 0; mkdir(b, 0775); *s = '/'; }
+    mkdir(b, 0775);
+}
+static void write_job(const job *j) {
+    const char *tmp = getenv("DM_TEMP"), *od = getenv("DM_VK_RTDUMP_DIR"); if (!tmp) tmp = "/data/local/tmp";
+    char dir[512], path[640];
+    if (od && *od) snprintf(dir, sizeof dir, "%s/f%llu", od, (unsigned long long)j->frame); else snprintf(dir, sizeof dir, "%s/rtdump/f%llu", tmp, (unsigned long long)j->frame);
+    mkdirs(dir);
+    snprintf(path, sizeof path, "%s/%04u_%c%03u_s%llu_%d_%ux%u_%016llx.png", dir, j->seq, j->kind, j->pass, (unsigned long long)j->serial, (int)j->vf, j->w, j->h, (unsigned long long)j->key);
+    uint32_t ow = j->depth ? j->w : j->sw, oh = j->depth ? j->h : j->sh, step = 1;
+    if (j->depth) { uint32_t m = ow > oh ? ow : oh; while (m / step > (uint32_t)g_px) step++; }
+    uint32_t pw = (ow + step - 1) / step, ph = (oh + step - 1) / step;
+    uint8_t *rgb = malloc((size_t)pw * ph * 3); if (!rgb) return;
+    if (j->depth) {
+        float lo = INFINITY, hi = -INFINITY;
+        for (uint32_t y = 0; y < oh; y += step) for (uint32_t x = 0; x < ow; x += step) {
+            float v = j->depth_bytes == 2 ? ((const uint16_t *)j->p)[(size_t)y * ow + x] / 65535.0f : ((const float *)j->p)[(size_t)y * ow + x];
+            if (j->vf != VK_FORMAT_D16_UNORM && j->vf != VK_FORMAT_D32_SFLOAT && j->vf != VK_FORMAT_D32_SFLOAT_S8_UINT) v = (float)(((const uint32_t *)j->p)[(size_t)y * ow + x] & 0xffffff) / 16777215.0f;   // D24: the low 24 bits
+            if (v < lo) lo = v; if (v > hi) hi = v;
+        }
+        float sc = hi > lo ? 255.0f / (hi - lo) : 0;
+        for (uint32_t y = 0, py = 0; y < oh; y += step, py++) for (uint32_t x = 0, px = 0; x < ow; x += step, px++) {
+            float v = j->depth_bytes == 2 ? ((const uint16_t *)j->p)[(size_t)y * ow + x] / 65535.0f : ((const float *)j->p)[(size_t)y * ow + x];
+            if (j->vf != VK_FORMAT_D16_UNORM && j->vf != VK_FORMAT_D32_SFLOAT && j->vf != VK_FORMAT_D32_SFLOAT_S8_UINT) v = (float)(((const uint32_t *)j->p)[(size_t)y * ow + x] & 0xffffff) / 16777215.0f;
+            uint8_t g = (uint8_t)fminf(255.0f, fmaxf(0.0f, (v - lo) * sc)); uint8_t *o = rgb + ((size_t)py * pw + px) * 3; o[0] = o[1] = o[2] = g;
+        }
+        LOG("[vk] rtdump %04u %c%u frame %llu serial %llu depth VkFormat %d %ux%u: range %.6f .. %.6f (%u draws; first fragment %016llx)", j->seq, j->kind, j->pass, (unsigned long long)j->frame,
+            (unsigned long long)j->serial, (int)j->vf, j->w, j->h, lo, hi, j->ndraws, (unsigned long long)j->key);
+    } else {
+        const uint16_t *hp = j->p; size_t n = (size_t)ow * oh; double sum[4] = {0}, lum = 0; float mn[4] = {INFINITY, INFINITY, INFINITY, INFINITY}, mx[4] = {-INFINITY, -INFINITY, -INFINITY, -INFINITY};
+        uint32_t nan = 0, inf = 0, black = 0; float *f = malloc(n * 4 * sizeof *f); if (!f) { free(rgb); return; }
+        for (size_t i = 0; i < n; i++) {
+            int bad = 0;
+            for (int c = 0; c < 4; c++) { float v = half_f(hp[i * 4 + c]); f[i * 4 + c] = v;
+                if (isnan(v)) { nan++; bad = 1; continue; } if (isinf(v)) { inf++; bad = 1; continue; }
+                if (v < mn[c]) mn[c] = v; if (v > mx[c]) mx[c] = v; sum[c] += v; }
+            if (!bad) { double l = 0.2126 * f[i * 4] + 0.7152 * f[i * 4 + 1] + 0.0722 * f[i * 4 + 2]; lum += l; if (l <= 0) black++; }
+        }
+        double ml = lum / (double)n, ex = ml > 1e-12 ? 0.18 / ml : 1.0;
+        for (uint32_t y = 0; y < ph; y++) for (uint32_t x = 0; x < pw; x++) {
+            const float *v = f + ((size_t)y * ow + x) * 4; uint8_t *o = rgb + ((size_t)y * pw + x) * 3;
+            for (int c = 0; c < 3; c++) { float t = v[c]; if (!(t == t) || isinf(t)) { o[0] = 255; o[1] = 0; o[2] = 255; break; }   // NaN / Inf: magenta
+                t = (float)(t * ex); t = t > 0 ? t / (1 + t) : 0; o[c] = (uint8_t)fminf(255.0f, powf(t, 1 / 2.2f) * 255.0f + 0.5f); }
+        }
+        LOG("[vk] rtdump %04u %c%u frame %llu serial %llu VkFormat %d %ux%u: min %g %g %g %g max %g %g %g %g mean %g %g %g %g, mean luminance %g, %u NaN %u Inf, %.1f%% black (%u draws; first fragment %016llx)",
+            j->seq, j->kind, j->pass, (unsigned long long)j->frame, (unsigned long long)j->serial, (int)j->vf, j->w, j->h, mn[0], mn[1], mn[2], mn[3], mx[0], mx[1], mx[2], mx[3],
+            sum[0] / n, sum[1] / n, sum[2] / n, sum[3] / n, ml, nan, inf, 100.0 * black / n, j->ndraws, (unsigned long long)j->key);
+        free(f);
+    }
+    if (!png_write(path, rgb, pw, ph)) { static int e; if (e++ < 4) LOG("[vk] [RED] rtdump: %s not written (errno %d)", path, errno); }
+    free(rgb);
+}
+static void written(void *arg) {
+    for (job *j = arg, *nx; j; j = nx) {
+        nx = j->next;
+        if (atomic_fetch_add(&g_written, 1) < g_max) write_job(j);
+        job_free(j);
+    }
+}
+
+// ---------- Hooks ----------
+// After a render pass ended (its writes made visible by the caller's barrier): its colour attachments and depth attachment
+void vka_rtd_pass(VkCommandBuffer cb, vka_img *const *ims, const uint32_t *lvs, const uint32_t *l0s, int n, vka_img *dim, uint32_t dlv, uint32_t dl0) {
+    if (!g_on) return;
+    uint64_t key = g_nfs ? g_fs[0] : 0; int w = want();
+    if (w) {
+        int any = 0; job *before = g_jobs;
+        for (int i = 0; i < n; i++) dump_one(cb, ims[i], lvs[i], l0s[i], 'p', key);
+        if (dim) dump_one(cb, dim, dlv, dl0, 'p', key);
+        any = g_jobs != before;
+        if (any) host_barrier(cb);
+        vka_barrier(cb);
+        g_pass++;
+    }
+    g_nfs = 0; g_ndraws = 0;
+}
+// After a compute dispatch (its writes made visible): the float storage images it bound, level 0, layer 0
+void vka_rtd_dispatch(VkCommandBuffer cb, uint64_t key, vka_img *const *ims, int n) {
+    if (!g_on || !want()) return;
+    job *before = g_jobs; uint32_t nd = g_ndraws; g_ndraws = 1;
+    for (int i = 0; i < n; i++) { int dup = 0; for (int k = 0; k < i; k++) dup |= ims[k] == ims[i]; if (!dup) dump_one(cb, ims[i], 0, 0, 'd', key); }
+    if (g_jobs != before) { host_barrier(cb); vka_barrier(cb); }
+    g_ndraws = nd; g_pass++;
+}
+void vka_rtd_commit(uint64_t fence) {   // this submission's readbacks are written once fence is done
+    if (!g_on || !g_jobs) return;
+    vka_after(fence, written, g_jobs); g_jobs = NULL;
+}
+#endif
