+                uint32_t isn[4] = {GW(G_OpIsNan, 4), t_bvec[n], sid, a[1]},
+                         cl[8] = {GW(G_OpExtInst, 8), t, sid + 1, glsl, G_FClamp, a[1], cst[n][1], cst[n][2]},
+                         se[6] = {GW(G_OpSelect, 6), t, sid + 2, sid, cst[n][0], sid + 1};
