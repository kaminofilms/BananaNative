+typedef struct { uint32_t *w; size_t n, cap; } gv_t;
+static int gput(gv_t *v, uint32_t x) {
+    if (v->n == v->cap) { size_t c = v->cap ? 2 * v->cap : 8192; uint32_t *p = realloc(v->w, c * 4); if (!p) return 0; v->w = p; v->cap = c; }
+    v->w[v->n++] = x; return 1;
+}
