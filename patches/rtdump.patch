+    free(ptee); free(outv); free(flt); free(loc); free(bi);
+    *out_nw = o.n;
+    snprintf(err, errn, "%zu float colour stores guarded", nstore);
+    return o.w;
+fail:
+    free(ptee); free(outv); free(flt); free(loc); free(bi); free(o.w);
+    return NULL;
+#undef GFAIL
+}
