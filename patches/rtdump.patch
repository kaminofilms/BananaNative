+        else if (op == G_OpEntryPoint && model == ~0u && len >= 2) model = a[0];
+        else if (op == G_OpDecorate && len >= 4 && a[0] < bound && a[1] == G_DecLocation) loc[a[0]] = 1;
+        else if (op == G_OpDecorate && len >= 3 && a[0] < bound && a[1] == G_DecBuiltIn) bi[a[0]] = 1;
