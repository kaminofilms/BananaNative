+       G_OpConstant = 43, G_OpConstantComposite = 44, G_OpConstantNull = 46, G_OpFunction = 54, G_OpVariable = 59, G_OpStore = 62, G_OpAccessChain = 65,
+       G_OpInBoundsAccessChain = 66, G_OpDecorate = 71, G_OpExtInst = 12, G_OpIsNan = 156, G_OpSelect = 169 };
