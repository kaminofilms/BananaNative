+        } else if ((op == S_OpAccessChain || op == S_OpInBoundsAccessChain) && len >= 4 && a[2] < bound && derived[a[2]]) {
+            size_t at = o.n; if (!sput_n(&o, w + i, len)) SFAIL("out of memory");
+            for (int m = 0; m < nmap; m++) if (chain_map[m][0] == a[0]) o.w[at + 1] = chain_map[m][1];
+            skip = 1;
+        }
+        if (i == first_fn) {   // the new globals, before the first function
+            for (int q = 0; q < nnew; q++) { uint32_t p[4] = {OPW(S_OpTypePointer, 4), newptr[q][0], newptr[q][1], newptr[q][2]}; if (!sput_n(&o, p, 4)) SFAIL("out of memory"); }
+            for (int q = 0; q < nnewc; q++) { uint32_t c[4] = {OPW(S_OpConstant, 4), t_int, cidx[newc[q]], newc[q]}; if (!sput_n(&o, c, 4)) SFAIL("out of memory"); }
+            if (cnull) { uint32_t z[3] = {OPW(46, 3), t_v4f, cnull}; if (!sput_n(&o, z, 3)) SFAIL("out of memory"); }   // OpConstantNull
+            for (int t = 0; t < ntg; t++) for (uint32_t k = 0; k < tg[t].n; k++) if (USED(tg[t], k)) { uint32_t v[4] = {OPW(S_OpVariable, 4), p_io_v4, tg[t].base + k, sc_io}; if (!sput_n(&o, v, 4)) SFAIL("out of memory"); }
+        }
+        if (op == S_OpFunction && len >= 5) { in_entry = a[1] == entry_fn; past_label = 0; }
+        if (!outside && in_entry && !copied && past_label && op != S_OpVariable && op != S_OpLine && op != S_OpNoLine) {   // inputs: into the array, after the entry block's variables
+            for (int t = 0; t < ntg; t++) for (uint32_t k = 0; k < tg[t].n; k++) {
+                int u = USED(tg[t], k);
+                uint32_t ld[4] = {OPW(S_OpLoad, 4), t_v4f, id, tg[t].base + k}, ac[5] = {OPW(S_OpAccessChain, 5), p_priv_v4, id + 1, tg[t].var, cidx[k]}, st[3] = {OPW(S_OpStore, 3), id + 1, u ? id : cnull};
+                if ((u && !sput_n(&o, ld, 4)) || !sput_n(&o, ac, 5) || !sput_n(&o, st, 3)) SFAIL("out of memory");
+                id += 2;
+            }
+            copied = 1;
+        }
+        if (outside && ((in_entry && (op == S_OpReturn || op == S_OpReturnValue)) || (model == S_ExecGeometry && (op == S_OpEmitVertex || op == S_OpEmitStreamVertex)))) {   // outputs: out of the array
+            for (int t = 0; t < ntg; t++) for (uint32_t k = 0; k < tg[t].n; k++) {
+                uint32_t ac[5] = {OPW(S_OpAccessChain, 5), p_priv_v4, id, tg[t].var, cidx[k]}, ld[4] = {OPW(S_OpLoad, 4), t_v4f, id + 1, id}, st[3] = {OPW(S_OpStore, 3), tg[t].base + k, id + 1};
+                if (!sput_n(&o, ac, 5) || !sput_n(&o, ld, 4) || !sput_n(&o, st, 3)) SFAIL("out of memory");
+                id += 2;
+            }
+            copied = 1;
+        }
+        if (in_entry && op == S_OpLabel) past_label = 1;
+        if (!skip && !sput_n(&o, w + i, len)) SFAIL("out of memory");
+        i += len;
+    }
+    if (!copied) SFAIL("the entry point's first block was not found");
+    if (id > nb) SFAIL("id bound overrun (%u > %u)", id, nb);
+    o.w[3] = id > copy_ids ? id : nb;   // the ids used (the copy ids were reserved for every site)
+    if (o.w[3] < copy_ids) o.w[3] = copy_ids;
+    free(loc); free(arr_elem); free(arr_len); free(cval); free(isvar); free(derived); free(ctype); free(ptrs);
+    *out_nw = o.n;
+    tot -= (uint32_t)nnull;
+    snprintf(err, errn, nnull ? "%s: %d %s array(s) split into %u variables, %d more locations the previous stage does not write read as 0" : "%s: %d %s array(s) split into %u variables", model == S_ExecFragment ? "pixel" : model == S_ExecVertex ? "vertex" : model == S_ExecGeometry ? "geometry" : "tessellation evaluation",
+             ntg, outside ? "output" : "input", tot, nnull);
+    return o.w;
+fail:
+    free(loc); free(arr_elem); free(arr_len); free(cval); free(isvar); free(derived); free(ctype); free(ptrs); free(o.w);
+    return NULL;
+#undef SFAIL
+#undef FINDPTR
+#undef USED
+}
+
+// The locations a vertex / tessellation evaluation / geometry module's entry point writes (its Output variables with a Location; an array of N covers N): bit per location
+uint64_t vka_spv_out_locs(const uint32_t *w, size_t nw) {
+    if (nw < 5 || w[0] != 0x07230203) return 0;
+    uint32_t bound = w[3]; uint64_t m = 0;
+    uint32_t *loc = calloc(bound, 4), *vt = calloc(bound, 4), *pt = calloc(bound, 4), *alen = calloc(bound, 4), *cv = calloc(bound, 4), *ael = calloc(bound, 4), *ism = calloc(bound, 4);
+    if (!loc || !vt || !pt || !alen || !cv || !ael || !ism) goto done;
+    for (uint32_t i = 0; i < bound; i++) loc[i] = ~0u;
+    for (size_t i = 5; i < nw;) {
+        uint32_t op = w[i] & 0xffff, len = w[i] >> 16; const uint32_t *a = w + i + 1;
+        if (!len || i + len > nw) break;
+        if (op == S_OpFunction) break;
+        if (op == S_OpDecorate && len >= 4 && a[1] == S_DecLocation && a[0] < bound) loc[a[0]] = a[2];
+        else if (op == S_OpTypePointer && len >= 4 && a[0] < bound && a[1] == S_SCOutput) pt[a[0]] = a[2] + 1;
+        else if (op == S_OpTypeArray && len >= 4 && a[0] < bound) { alen[a[0]] = a[2]; ael[a[0]] = a[1] + 1; }
+        else if (op == S_OpConstant && len >= 4 && a[1] < bound) cv[a[1]] = a[2];
+        else if (op == S_OpVariable && len >= 4 && a[2] == S_SCOutput && a[1] < bound && a[0] < bound) vt[a[1]] = a[0] + 1;
+        i += len;
+    }
+    for (uint32_t v = 1; v < bound; v++) {
+        if (!vt[v] || loc[v] == ~0u) continue;
+        uint32_t p = vt[v] - 1, t = pt[p] ? pt[p] - 1 : 0, n = 1;
+        if (t && t < bound && ael[t] && alen[t] < bound) { n = cv[alen[t]]; uint32_t e = ael[t] - 1; if (e < bound && ael[e]) n = 1; }   // a geometry / tess array of vertices: one location (no arrays of arrays here)
+        if (n < 1 || n > 64) n = 1;
+        for (uint32_t k = 0; k < n; k++) if (loc[v] + k < 64) m |= 1ull << (loc[v] + k);
+    }
+done:
+    free(loc); free(vt); free(pt); free(alen); free(cv); free(ael); free(ism);
+    return m;
+}
